# Copy to .env only for local use. Never commit the real file.
CYBERSEC_LAN_CIDR=192.168.100.0/24
CYBERSEC_LAN_INTERFACE=wlp6s0
CYBERSEC_VPN_CONNECTION=protonwg
CYBERSEC_VPN_ROUTE_TABLE=51820
CYBERSEC_TOR_SOCKS=127.0.0.1:9050

# Directorio fuera del repositorio para casos reales. Si no se define,
# scripts/new-case.sh utiliza el directorio hermano ../cases.
CYBERSEC_CASES_DIR=

# OSINT, DNS y TLS usan redes Docker externas. Deben crearse solo mediante
# scripts/configure-new-network-profiles.sh después de revisar su runbook.

# Credenciales opcionales para proveedores OSINT. Mantener vacías en este
# archivo y definirlas únicamente en .env local o en un gestor de secretos.
HIBP_API_KEY=
INTELX_API_KEY=
GITHUB_TOKEN=
