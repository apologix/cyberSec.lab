# Desarrollo local. Copiar a .env y reemplazar todos los valores de ejemplo.
CYBERLAB_ENVIRONMENT=development
CYBERLAB_HTTP_PORT=8080
POSTGRES_DB=cyberlab
POSTGRES_USER=cyberlab
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://cyberlab:change-this-local-password@postgres:5432/cyberlab
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-this-long-random-admin-password
SESSION_SECRET=change-this-long-random-session-secret
COOKIE_SECURE=false
COLLECTOR_SHARED_TOKEN=change-this-long-random-collector-token
TRUSTED_PROXY_CIDRS=172.16.0.0/12
DATA_RETENTION_RECON_DAYS=30
DATA_RETENTION_PRECISE_LOCATION_DAYS=7
DATA_RETENTION_HONEYPOT_DAYS=90
GEOIP_DATABASE_PATH=
