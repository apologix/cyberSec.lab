[Unit]
Description=Impacket Docker VPN kill switch
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/nft delete table inet impacket_killswitch
ExecStart=/usr/sbin/nft -f /etc/nftables-impacket.conf
ExecReload=/usr/sbin/nft delete table inet impacket_killswitch
ExecReload=/usr/sbin/nft -f /etc/nftables-impacket.conf
ExecStop=/usr/sbin/nft delete table inet impacket_killswitch

[Install]
WantedBy=multi-user.target
